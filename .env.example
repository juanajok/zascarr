# Copia a .env y rellena los valores. Nunca subas .env a git.
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────
# Contraseña de la base de datos. NO la rellenes a mano: `bootstrap.sh` (o, en una instalación
# manual, `sudo bash scripts/credenciales.sh`) genera una propia, la guarda aquí y deja este
# fichero legible solo para root. Con este valor de ejemplo —o vacía— ZascArr NO arranca.
DB_PASSWORD=cambia_esto_ahora

# ── Comic Vine — https://comicvine.gamespot.com/api/ ─────────
# Opcional. Solo si quieres enriquecer cómics americanos/británicos.
# Regístrate en https://comicvine.gamespot.com/api/ para obtener una API key.
COMICVINE_API_KEY=

# ── Límite de transferencia HTTP (opcional) ──────────────────
# Tope real de bytes por respuesta externa (1–16 MiB; 4 MiB por defecto). Un cuerpo
# mayor se corta al leerlo; no se reintenta.
# MAX_CUERPO_TRANSFER_BYTES=4194304
# Tope del Crawl-delay que pida un robots.txt (5–300 s; 60 s por defecto). Si un sitio
# legítimo pide más, súbelo aquí y reinicia.
# CRAWL_DELAY_MAX_S=60

# ── Prowlarr ──────────────────────────────────────────────────
# Opcional. Solo si usas Prowlarr como indexador.
PROWLARR_API_KEY=

# ── Transmission ───────────────────────────────────────────────
# Opcional. Solo si usas Transmission para descargas.
TRANSMISSION_USERNAME=transmission
TRANSMISSION_PASSWORD=

# ── aMule ──────────────────────────────────────────────────────
# Opcional. Solo si usas aMule para descargas eD2K.
AMULE_PASSWORD=

# ── Fuentes de metadatos (Comic Vine, AniList, Tebeosfera, GCD) ─
# Nacen APAGADAS y NO se gobiernan desde este fichero: se encienden en
# /ui/ajustes → «Fuentes de metadatos» (ADR 0013). Solo la clave de Comic
# Vine puede ir aquí (COMICVINE_API_KEY).

# ── Foro (plugin IPB genérico, desactivado por defecto) ────────
# Opcional. El proyecto NO incluye ni recomienda ningún foro concreto;
# la URL la aporta el usuario.
FORUM_ENABLED=false
FORUM_URL=
FORUM_USERNAME=
FORUM_PASSWORD=

# ── Lector de portadas de los .cbr (RAR) ───────────────────────
# `true` (por defecto): ZascArr lee la portada de los .cbr que son RAR con `unar`.
# `false`: lo apaga sin reconstruir la imagen (edita este fichero y recrea el contenedor); esos .cbr
# se quedan sin portada de archivo (se usa la antigua o la de internet, si las hay).
# Ver docs/adr/0015-lector-de-rar-con-unar.md.
# LECTOR_RAR_ENABLED=true

# ── Rutas en el HOST (dónde viven de verdad tus discos) ────────
# bootstrap.sh las pregunta y las escribe aquí (A1); si instalas a mano,
# apunta cada una a la ruta real de tus discos.
# Ejemplo:
# HOST_LIBRARY_DIR=/media/usuario/Tebeoteca
# HOST_DOWNLOADS_DIR=/media/usuario/Descargas
# HOST_AMULE_INCOMING_DIR=/media/usuario/aMule/Incoming
# (HOST_LIBRARY_DIR también se le pasa a la app, solo para ENSEÑARTE dónde está cada archivo en tu disco.)
HOST_LIBRARY_DIR=
HOST_DOWNLOADS_DIR=
HOST_AMULE_INCOMING_DIR=
# B20: carpeta del host donde se exportan colecciones para Kavita. Dentro del
# contenedor la raíz es siempre /media/export (EXPORT_PATH).
HOST_EXPORT_DIR=/media/data/export
EXPORT_PATH=/media/export

# ── Datos de los contenedores (Postgres, portadas, estado VPN) ──
# Separado del código a propósito, mismo patrón que el resto de la suite
# *arr: código en /opt, datos en /var/lib. bootstrap.sh la escribe sola;
# si instalas a mano, apunta donde quieras que vivan esos datos.
ZASCARR_DATA_DIR=/var/lib/zascarr

# ── Sistema ────────────────────────────────────────────────────
TZ=Europe/Madrid

# ── Ciclos automáticos (opcional; los valores por defecto sirven) ──
# Importación de descargas cada 15 min; búsqueda de deseados cada 60 min;
# enriquecimiento cada 120 min; rescan de la biblioteca una vez al día
# (1440). Para apagar un ciclo, pon su intervalo a 0.
# RESCAN_INTERVAL_MINUTES=1440

# Idioma preguntado en el bootstrap. Guardado para cuando exista i18n en
# la app; hoy los textos (dashboard, logs) están en español fijo.
APP_LOCALE=es

# ── Seguridad (opcional) ───────────────────────────────────────
# Solo hace falta si accedes por un dominio, tras un proxy inverso o por el
# nombre del equipo. Vacías por defecto: no cambies nada si entras por
# localhost o por una IP.

# Dominio público CON esquema (https://zascarr.tudominio.com). Necesario si un
# proxy inverso NO conserva el `Host` (nginx lo cambia por defecto): sin esto,
# los formularios devolverían 403. También se puede fijar desde /ui/ajustes.
BASE_URL=

# Nombres de host extra aceptados (separados por comas), además de localhost,
# las IP literales y el dominio de BASE_URL. Ej.: raspberrypi.local,pi
ALLOWED_HOSTS=

# ── Exposición de red (A11) ───────────────────────────────────────────────────
# Dónde publica el equipo la interfaz (puerto 8000). 127.0.0.1 = solo esta
# máquina (recomendado). 0.0.0.0 = también tu red local: exige contraseña, y lo
# normal es que lo cambie `bootstrap.sh` al preguntarte, no que lo edites a mano.
# PostgreSQL nunca se publica fuera de localhost, pase lo que pase.
ZASCARR_BIND_ADDRESS=127.0.0.1
