# =============================================================================
# SecuenciArr — Variables de entorno
# Copia a .env y rellena los valores. Nunca subas .env a git.
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────
DB_PASSWORD=cambia_esto_ahora

# ── Comic Vine — https://comicvine.gamespot.com/api/ ─────────
COMICVINE_API_KEY=

# ── Prowlarr (baremetal, Confiraspa) ─────────────────────────
PROWLARR_API_KEY=

# ── Transmission (baremetal, Confiraspa) ─────────────────────
TRANSMISSION_USERNAME=
TRANSMISSION_PASSWORD=

# ── aMule (baremetal, Confiraspa) ────────────────────────────
AMULE_PASSWORD=

# ── Forum La Mansión CRG (desactivado por defecto) ───────────
FORUM_ENABLED=false
FORUM_USERNAME=
FORUM_PASSWORD=

# ── Filesystem (dentro del contenedor — no tocar salvo que sepas
# ── por qué; para reubicar discos usa las rutas del HOST de abajo) ──
LIBRARY_PATH=/media/WDElements/Tebeos
TRANSMISSION_DOWNLOAD_DIR=/media/DiscoDuro/downloads/comics
AMULE_INCOMING_DIR=/media/DiscoDuro/aMule/Incoming

# ── Rutas en el HOST (lado izquierdo de los volúmenes en docker-compose.yml) ──
# bootstrap.sh las pregunta y las escribe aquí (A1); si instalas a mano,
# apunta cada una a donde vivan de verdad tus discos.
HOST_LIBRARY_DIR=/media/WDElements/Tebeos
HOST_DOWNLOADS_DIR=/media/DiscoDuro/downloads
HOST_AMULE_INCOMING_DIR=/media/DiscoDuro/aMule/Incoming

# ── Sistema ───────────────────────────────────────────────────
TZ=Europe/Madrid
# Idioma preguntado en el bootstrap. Guardado para cuando exista i18n en
# la app; hoy los textos (dashboard, logs) están en español fijo.
APP_LOCALE=es
