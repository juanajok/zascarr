# Copia a .env y rellena los valores. Nunca subas .env a git.
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────
# ContraseÃ±a de la base de datos. Cambia por una segura.
DB_PASSWORD=cambia_esto_ahora

# ── Comic Vine â https://comicvine.gamespot.com/api/ ââ¤½
# Opcional. Solo si quieres enriquecer cÃ³mics americanos/britÃ¡nicos.
# RegÃ©strate en https://comicvine.gamespot.com/api/ para obtener una API key.
COMICVINE_API_KEY=

# ── Prowlarr (baremetal, Confiraspa) ââ¤½
# Opcional. Solo si usas Prowlarr como indexador.
# URL: http://<host>:7878 (lado del contenedor)
PROWLARR_API_KEY=

# ── Transmission (baremetal, Confiraspa) ââ¤½
# Opcional. Solo si usas Transmission para descargas.
# URL: http://<host>:9091 (lado del contenedor)
TRANSMISSION_USERNAME=transmission
TRANSMISSION_PASSWORD=

# ── aMule (baremetal, Confiraspa) ââ¤½
# Opcional. Solo si usas aMule para descargas eD2K.
# URL: http://<host>:4711 (lado del contenedor)
AMULE_PASSWORD=

# ── Forum La MansiÃ³n CRG (desactivado por defecto) ââ¤½
# Opcional. Solo si configuras un scraper de foro IPB genÃ©rico.
# El proyecto NO incluye ni recomienda foros concretos.
FORUM_ENABLED=false
FORUM_URL=
FORUM_USERNAME=
FORUM_PASSWORD=

# ── Filesystem (dentro del contenedor â no tocar salvo que sepas
# â por quÃ©; para reubicar discos usa las rutas del HOST de abajo) ââ¤½
# Estas rutas son las que ve el contenedor. No las cambies salvo que
# modifiques tambiÃ©n los volÃºmenes de docker-compose.yml.
LIBRARY_PATH=/mnt/tebeoteca/library
TRANSMISSION_DOWNLOAD_DIR=/mnt/tebeoteca/downloads
AMULE_INCOMING_DIR=/mnt/tebeoteca/incoming

# ── Rutas en el HOST (lado izquierdo de los volÃºmenes en docker-compose.yml) ââ¤½
# bootstrap.sh las pregunta y las escribe aquÃ© (A1); si instalas a mano,
# apunta cada una a donde vivan de verdad tus discos.
# Ejemplo:
# HOST_LIBRARY_DIR=/media/usuario/Tebeoteca
# HOST_DOWNLOADS_DIR=/media/usuario/Descargas
# HOST_AMULE_INCOMING_DIR=/media/usuario/aMule/Incoming
HOST_LIBRARY_DIR=
HOST_DOWNLOADS_DIR=
HOST_AMULE_INCOMING_DIR=

# ── Sistema ââ¤½
TZ=Europe/Madrid

# Idioma preguntado en el bootstrap. Guardado para cuando exista i18n en
# la app; hoy los textos (dashboard, logs) estÃ¡n en espaÃ±ol fijo.
APP_LOCALE=es
