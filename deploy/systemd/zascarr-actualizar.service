# PROPUESTA DE LABORATORIO: no se instala ni se habilita desde este cambio.
[Unit]
Description=Actualización manual OPS4 desde main (acción fija)
Documentation=https://github.com/juanajok/zascarr
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=exec
User=root
WorkingDirectory=@REPO@
ExecStart=/bin/bash @REPO@/scripts/update.sh --rama main
ExecStartPost=/usr/bin/python3 -I /usr/local/lib/zascarr/zascarr-estado-actualizar-ops4 --ruta @ZASCARR_DATA_DIR@/ops/actualizar-status.json --resultado hecha
ExecStopPost=/bin/sh -c 'test "$SERVICE_RESULT" = success || /usr/bin/python3 -I /usr/local/lib/zascarr/zascarr-estado-actualizar-ops4 --ruta @ZASCARR_DATA_DIR@/ops/actualizar-status.json --resultado fallida'
RuntimeMaxSec=5400
TimeoutStopSec=60
KillMode=control-group
SendSIGKILL=yes
Restart=no
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# El script necesita escribir el repo, datos, copias y cerrojo; no se amplía a más.
ReadWritePaths=/opt/zascarr /var/lib/zascarr /var/backups/zascarr /run/zascarr-ops.lock
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE CAP_SETUID CAP_SETGID CAP_NET_BIND_SERVICE
# Sin [Install]: no arranca al boot ni se activa solo.
