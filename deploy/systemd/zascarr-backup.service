[Unit]
Description=Copia de seguridad diaria de PostgreSQL para ZascArr
Documentation=https://github.com/juanajok/zascarr
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/zascarr
ExecStart=/usr/local/bin/backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=30min
# 75 = había otra operación de ZascArr en marcha: no es un fallo de la unidad (BL-OPS1, FR-12.4)
SuccessExitStatus=75
