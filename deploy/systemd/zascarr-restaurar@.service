[Unit]
Description=ZascArr — restaurar la copia %i (BL-OPS2)
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/default/zascarr
ExecStart=/usr/local/lib/zascarr/restaurar-produccion %i
SuccessExitStatus=75
TimeoutStartSec=2700
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/zascarr-ops.lock @BACKUP_STATUS_DIR@
CapabilityBoundingSet=
