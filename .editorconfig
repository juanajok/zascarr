root = true

# Convenciones comunes. La CI no impone formato más allá de ruff; esto evita
# ruido de espacios, finales de línea y tabulaciones entre editores.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,html,css,js}]
indent_size = 2

[*.md]
# En Markdown, dos espacios al final son un salto de línea deliberado.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
indent_size = 4
